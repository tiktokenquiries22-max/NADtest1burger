# SMTP Email Notification Credentials for Contact Form
# Add these variables in Vercel Dashboard (Project Settings > Environment Variables)
# or in a local .env.local file.

# Recipient Email: igmfx@outlook.com (configured in API route)
SMTP_HOST="smtp.office365.com"
SMTP_PORT="587"
SMTP_USER="igmfx@outlook.com"
SMTP_PASS="YOUR_OUTLOOK_APP_PASSWORD"
